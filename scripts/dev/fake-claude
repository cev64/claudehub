#!/usr/bin/env bash
if [ "$1" = "--version" ]; then echo "2.1.295 (Claude Code)"; exit 0; fi
if [ "$1" = "auth" ]; then echo '{"loggedIn":true,"authMethod":"claude.ai"}'; exit 0; fi
echo "ARGS: $*" >> "${FAKE_LOG:-/dev/null}"
if [ "$1" = "--cloud" ]; then
  echo "Creating cloud session..."
  echo "View at https://claude.ai/code/session_FAKE123 now"
  exit 0
fi
trap 'echo "got TERM" >&2; exit 143' TERM
echo '{"type":"system","subtype":"init","session_id":"sess-1234abcd","model":"claude-sonnet","cwd":"'"$PWD"'"}'
echo 'not json line'
echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Looking at the repo."},{"type":"tool_use","name":"Read","input":{"file_path":"/tmp/x/README.md"}}]}}'
echo '{"type":"user","message":{"content":[{"type":"tool_result","content":"ok"}]}}'
echo '{"type":"assistant","parent_tool_use_id":"t1","message":{"content":[{"type":"text","text":"subagent chatter"}]}}'
echo 'warning on stderr' >&2
case "$*" in *slow*) for i in $(seq 1 60); do sleep 0.5 & wait $!; done;; *) sleep 1;; esac
echo '{"type":"assistant","message":{"content":[{"type":"text","text":"All done."}]}}'
echo '{"type":"result","subtype":"success","is_error":false,"result":"All done.","session_id":"sess-1234abcd"}'
